{
  "info": {
    "name": "Agentic Kanban - Sesión 2",
    "description": "Contrato HTTP de la API del tablero. Autenticación real de Better Auth con cookie de sesión (sin Bearer). Ejecuta las carpetas 01 a 05 en orden. baseUrl por defecto http://localhost:3000 (cámbialo a :3002 o :5173). Las peticiones a /api/auth/* llevan Origin: {{origin}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "API en :3000. Cambia a http://localhost:3002 o a http://localhost:5173 (proxy de Vite+)."
    },
    {
      "key": "origin",
      "value": "http://localhost:5173",
      "type": "string",
      "description": "Origen de confianza que Better Auth exige en /api/auth/*."
    },
    {
      "key": "workspaceId",
      "value": "",
      "type": "string",
      "description": "Se rellena en Get Workspaces."
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string",
      "description": "Se rellena en Get Workspaces."
    },
    {
      "key": "columnId",
      "value": "",
      "type": "string",
      "description": "Se rellena en Get Board."
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string",
      "description": "Se rellena en Create Task."
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login Ana",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON válido con usuario\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.user).to.be.an(\"object\");",
                  "  pm.expect(json.user.id).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@demo.test\",\n  \"password\": \"Demo1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "email"]
            },
            "description": "Better Auth guarda la cookie de sesión en el cookie jar de Postman. Origin obligatorio."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Workspaces",
      "item": [
        {
          "name": "Get Workspaces",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"es un array de workspaces\", () => pm.expect(json).to.be.an(\"array\").and.not.empty);",
                  "const withProjects = json.filter((ws) => Array.isArray(ws.projects) && ws.projects.length > 0);",
                  "const preferred = withProjects.find((ws) => ws.projects.some((p) => p.name === \"Agentic Kanban\"));",
                  "const workspace = preferred ?? withProjects[0];",
                  "pm.test(\"hay un workspace con projects\", () => pm.expect(workspace, \"workspace con projects\").to.be.an(\"object\"));",
                  "if (workspace) {",
                  "  const project = workspace.projects.find((p) => p.name === \"Agentic Kanban\") ?? workspace.projects[0];",
                  "  pm.test(\"ids presentes\", () => {",
                  "    pm.expect(workspace.id).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(project.id).to.be.a(\"string\").and.not.empty;",
                  "  });",
                  "  pm.collectionVariables.set(\"workspaceId\", workspace.id);",
                  "  pm.collectionVariables.set(\"projectId\", project.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces"]
            },
            "description": "Elige el workspace con un project «Agentic Kanban» o, si no, el primero con projects. Sin ids fijos."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Board",
      "item": [
        {
          "name": "Get Board",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"proyecto y columnas presentes\", () => {",
                  "  pm.expect(json.project.id).to.eql(pm.collectionVariables.get(\"projectId\"));",
                  "  pm.expect(json.columns).to.be.an(\"array\").and.not.empty;",
                  "  pm.expect(json.columns[0].id).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"columnId\", json.columns[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/board",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "board"]
            },
            "description": "Guarda el id de la primera columna en columnId."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Tasks",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
