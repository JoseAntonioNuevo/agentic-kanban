                  "pm.test(\"tarea con id y título\", () => {",
                  "  pm.expect(json.id).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(json.title).to.eql(\"Tarea de Postman\");",
                  "});",
                  "pm.collectionVariables.set(\"taskId\", json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"columnId\": \"{{columnId}}\",\n  \"title\": \"Tarea de Postman\",\n  \"description\": \"Creada desde la colección\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}", "tasks"]
            }
          },
          "response": []
