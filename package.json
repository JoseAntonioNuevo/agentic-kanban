{
  "name": "agentic-kanban",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "dev:web": "vp dev apps/web --host 0.0.0.0 --port 5173",
    "dev:api": "bun --filter @agentic-kanban/api dev",
    "check": "vp check",
    "test": "vp test",
    "build": "vp build apps/web",
    "db:generate": "bun --filter @agentic-kanban/db generate",
    "db:migrate": "bun --filter @agentic-kanban/db migrate",
    "db:seed": "bun --filter @agentic-kanban/api seed"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "bun-types": "1.4.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.3"
}
