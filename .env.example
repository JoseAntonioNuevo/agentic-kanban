# URL del fichero libSQL en el Mac. Compose la pisa a file:/data/agentic-kanban.db
DATABASE_URL=file:./data/agentic-kanban.db
# Puerto interno de Hono.
API_PORT=3000
# Puerto publicado en el Mac (cámbialo si 3000 está ocupado).
API_HOST_PORT=3000
# Destino del proxy Vite+ cuando corres el frontend en el host.
API_PROXY_TARGET=http://localhost:3000

# Secreto de Better Auth. Compose lo define en desarrollo; vacío aquí a propósito.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Tope de POST /sign-up/email y /sign-in/email por minuto (por defecto 10).
# AUTH_RATE_LIMIT_MAX=10

# Email real (Cloudflare Email Service). Vacías: el correo va al outbox local.
# No llames CLOUDFLARE_API_TOKEN al token de correo: wrangler lo usaría para desplegar.
CLOUDFLARE_ACCOUNT_ID=
# Token con el permiso «Email Sending: Edit».
CLOUDFLARE_EMAIL_TOKEN=
# Dirección de un dominio incorporado a Email Sending.
MAIL_FROM=
# Si existe, todos los emails van aquí (los usuarios demo son @demo.test).
MAIL_REDIRECT_TO=
